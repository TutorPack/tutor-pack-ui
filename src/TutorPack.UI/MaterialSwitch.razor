<label class="tp-switch @Class">
    <span>@Label</span>
    <input type="checkbox" role="switch" aria-label="@(AriaLabel ?? Label)"
           @bind:get="Value" @bind:set="SetValueAsync" disabled="@Disabled" />
    <span class="tp-switch-track" aria-hidden="true"></span>
</label>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public bool Value { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<bool> ValueChanged { get; set; }

    private Task SetValueAsync(bool value) => ValueChanged.InvokeAsync(value);
}
